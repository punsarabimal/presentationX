<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <title>Event Agenda Presentation</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Sinhala:wght@500;700;800&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
        }

        html, body {
            width: 100%;
            min-height: 100vh;
            min-height: 100dvh;
            font-family: 'Noto Sans Sinhala', sans-serif;
            background-color: #0f172a;
            background-image: url('https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=1920&q=80');
            background-repeat: no-repeat;
            background-position: center center;
            background-size: cover;
            background-attachment: fixed;
            color: #FFFFFF;
            overflow-x: hidden;
        }

        body {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: clamp(12px, 2.5vh, 32px);
        }

        /* MAIN AGENDA MENU CARD */
        .agenda-container {
            position: relative;
            z-index: 5;
            background: rgba(15, 23, 42, 0.52);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1.5px solid rgba(255, 255, 255, 0.35);
            border-radius: clamp(14px, 2vw, 20px);
            padding: clamp(18px, 3vh, 30px) clamp(20px, 4vw, 48px);
            text-align: center;
            box-shadow: 0 18px 40px rgba(0, 0, 0, 0.5);
            width: 100%;
            max-width: clamp(310px, 88vw, 560px);
            max-height: 94dvh;
            overflow-y: auto;
        }

        .agenda-container.hidden {
            display: none;
        }

        .logo {
            width: clamp(34px, 4.5vw, 48px);
            height: clamp(34px, 4.5vw, 48px);
            margin-bottom: clamp(6px, 1vh, 10px);
            border-radius: 50%;
            object-fit: contain;
        }

        .logo.hidden {
            display: none;
        }

        .main-title {
            color: #00E5FF;
            font-size: clamp(1.35rem, 3vw, 2rem);
            font-weight: 800;
            line-height: 1.3;
            margin-bottom: clamp(12px, 2vh, 18px);
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.65);
        }

        .agenda-list {
            display: flex;
            flex-direction: column;
            gap: clamp(3px, 0.6vh, 6px);
        }

        .agenda-btn {
            background: transparent;
            border: 1px solid transparent;
            color: #FFFFFF;
            font-family: inherit;
            font-size: clamp(0.95rem, 2vw, 1.2rem);
            font-weight: 700;
            padding: clamp(4px, 0.8vh, 7px) clamp(12px, 2vw, 16px);
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s ease;
            text-shadow: 0 2px 6px rgba(0, 0, 0, 0.9);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
        }

        .agenda-btn:hover, .agenda-btn:focus-visible {
            background: rgba(0, 229, 255, 0.2);
            border-color: rgba(0, 229, 255, 0.5);
            color: #00E5FF;
            transform: scale(1.03);
            outline: none;
        }

        .event-date {
            margin-top: clamp(12px, 2vh, 18px);
            color: #E2E8F0;
            font-size: clamp(0.9rem, 1.7vw, 1.05rem);
            font-weight: 700;
            letter-spacing: 1px;
            text-shadow: 0 2px 6px rgba(0, 0, 0, 0.85);
        }

        /* SIMPLE INDIVIDUAL SLIDE SCREENS */
        .slide-screen {
            display: none;
            position: fixed;
            inset: 0;
            width: 100%;
            height: 100dvh;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: clamp(16px, 4vw, 48px);
            z-index: 20;
            animation: simpleFade 0.3s ease forwards;
        }

        .slide-screen.active {
            display: flex;
        }

        @keyframes simpleFade {
            from {
                opacity: 0;
                transform: scale(0.97);
            }
            to {
                opacity: 1;
                transform: scale(1);
            }
        }

        /* Subtle corner back button */
        .back-btn {
            position: fixed;
            top: clamp(14px, 2.5vh, 24px);
            right: clamp(14px, 2.5vw, 24px);
            background: rgba(15, 23, 42, 0.55);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.35);
            color: #FFFFFF;
            font-family: inherit;
            font-size: clamp(0.8rem, 1.4vw, 0.95rem);
            font-weight: 700;
            padding: 6px 16px;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s ease;
            z-index: 30;
        }

        .back-btn:hover {
            background: #00E5FF;
            color: #0F172A;
            border-color: #00E5FF;
        }

        /* Center Content Wrapper */
        .simple-slide-wrapper {
            width: 100%;
            max-width: clamp(320px, 85vw, 760px);
            text-align: center;
            z-index: 25;
        }

        .simple-slide-title {
            color: #FFFFFF;
            font-size: clamp(1.6rem, 4vw, 2.8rem);
            font-weight: 800;
            margin-bottom: clamp(14px, 2.5vh, 24px);
            text-shadow: 0 3px 14px rgba(0, 0, 0, 0.9), 0 0 25px rgba(0, 0, 0, 0.6);
            line-height: 1.3;
        }

        .simple-slide-box {
            background: rgba(10, 15, 22, 0.62);
            backdrop-filter: blur(6px);
            -webkit-backdrop-filter: blur(6px);
            padding: clamp(20px, 4vw, 38px) clamp(22px, 4.5vw, 44px);
            border-radius: 4px;
            text-align: left;
            box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
        }

        .simple-slide-text {
            color: #FFFFFF;
            font-size: clamp(1.05rem, 2.3vw, 1.55rem);
            font-weight: 700;
            line-height: 1.65;
            text-shadow: 0 2px 6px rgba(0, 0, 0, 0.85);
            white-space: pre-line;
        }

        /* SUBTLE SETTINGS BUTTON (BOTTOM-RIGHT) */
        .edit-trigger-btn {
            position: fixed;
            bottom: 14px;
            right: 14px;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: rgba(15, 23, 42, 0.45);
            border: 1px solid rgba(255, 255, 255, 0.25);
            color: #FFFFFF;
            font-size: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            opacity: 0.28;
            transition: all 0.25s ease;
            z-index: 40;
        }

        .edit-trigger-btn:hover {
            opacity: 1;
            background: #00E5FF;
            color: #0F172A;
            transform: rotate(45deg);
        }

        /* EDITOR MODAL OVERLAY */
        .editor-modal {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(2, 6, 23, 0.85);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            z-index: 100;
            justify-content: center;
            align-items: center;
            padding: 16px;
        }

        .editor-modal.open {
            display: flex;
        }

        .editor-box {
            background: #1E293B;
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 16px;
            width: 100%;
            max-width: 720px;
            max-height: 90dvh;
            display: flex;
            flex-direction: column;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.7);
            overflow: hidden;
        }

        .editor-header {
            padding: 16px 22px;
            background: #0F172A;
            border-bottom: 1px solid rgba(255, 255, 255, 0.12);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .editor-header h3 {
            color: #00E5FF;
            font-size: 1.2rem;
            font-weight: 800;
        }

        .close-editor-btn {
            background: transparent;
            border: none;
            color: #94A3B8;
            font-size: 1.5rem;
            cursor: pointer;
            line-height: 1;
        }

        .close-editor-btn:hover {
            color: #FFFFFF;
        }

        .editor-body {
            padding: 20px 22px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 18px;
        }

        .form-section {
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            padding: 14px 16px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .form-section-title {
            color: #00E5FF;
            font-size: 0.95rem;
            font-weight: 700;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            padding-bottom: 6px;
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        @media (max-width: 600px) {
            .form-grid {
                grid-template-columns: 1fr;
            }
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .form-group label {
            font-size: 0.85rem;
            color: #CBD5E1;
            font-weight: 600;
        }

        .form-control {
            background: #0F172A;
            border: 1px solid rgba(255, 255, 255, 0.22);
            border-radius: 8px;
            padding: 8px 12px;
            color: #FFFFFF;
            font-family: inherit;
            font-size: 0.95rem;
            width: 100%;
        }

        .form-control:focus {
            outline: none;
            border-color: #00E5FF;
        }

        textarea.form-control {
            resize: vertical;
            min-height: 68px;
        }

        .file-row {
            display: flex;
            gap: 8px;
            align-items: center;
            flex-wrap: wrap;
        }

        .file-label-btn {
            background: rgba(0, 229, 255, 0.15);
            border: 1px solid #00E5FF;
            color: #00E5FF;
            padding: 7px 12px;
            border-radius: 8px;
            font-size: 0.85rem;
            font-weight: 700;
            cursor: pointer;
            white-space: nowrap;
        }

        .file-label-btn:hover {
            background: #00E5FF;
            color: #0F172A;
        }

        .small-clear-btn {
            background: rgba(239, 68, 68, 0.18);
            border: 1px solid rgba(239, 68, 68, 0.5);
            color: #FCA5A5;
            padding: 7px 10px;
            border-radius: 8px;
            font-size: 0.8rem;
            font-weight: 700;
            cursor: pointer;
        }

        .slide-edit-card {
            background: #0F172A;
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 10px;
            padding: 12px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .slide-edit-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 8px;
        }

        .slide-num-tag {
            font-size: 0.8rem;
            font-weight: 800;
            color: #00E5FF;
            background: rgba(0, 229, 255, 0.12);
            padding: 3px 10px;
            border-radius: 12px;
        }

        .slide-card-actions {
            display: flex;
            gap: 5px;
        }

        .icon-btn {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: #FFFFFF;
            width: 28px;
            height: 28px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.85rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .icon-btn:hover {
            background: rgba(0, 229, 255, 0.25);
            border-color: #00E5FF;
        }

        .icon-btn.del:hover {
            background: rgba(239, 68, 68, 0.35);
            border-color: #EF4444;
        }

        .add-item-btn {
            background: rgba(0, 229, 255, 0.15);
            border: 1.5px dashed #00E5FF;
            color: #00E5FF;
            font-family: inherit;
            font-size: 0.95rem;
            font-weight: 700;
            padding: 10px;
            border-radius: 10px;
            cursor: pointer;
            width: 100%;
            transition: all 0.2s ease;
        }

        .add-item-btn:hover {
            background: rgba(0, 229, 255, 0.28);
        }

        .editor-footer {
            padding: 14px 22px;
            background: #0F172A;
            border-top: 1px solid rgba(255, 255, 255, 0.12);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .footer-left-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .blank-btn {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.35);
            color: #FFFFFF;
            font-family: inherit;
            font-size: 0.85rem;
            font-weight: 700;
            padding: 8px 14px;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .blank-btn:hover {
            background: rgba(255, 255, 255, 0.22);
            border-color: #FFFFFF;
        }

        .reset-btn {
            background: transparent;
            border: 1px solid rgba(239, 68, 68, 0.6);
            color: #FCA5A5;
            font-family: inherit;
            font-size: 0.85rem;
            font-weight: 700;
            padding: 8px 14px;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .reset-btn:hover {
            background: rgba(239, 68, 68, 0.2);
        }

        .save-btn {
            background: #00E5FF;
            border: none;
            color: #0F172A;
            font-family: inherit;
            font-size: 0.95rem;
            font-weight: 800;
            padding: 9px 24px;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .save-btn:hover {
            background: #38BDF8;
        }
    </style>
</head>
<body>

    <!-- MAIN AGENDA MENU -->
    <div class="agenda-container" id="agendaScreen">
        <img src="https://via.placeholder.com/44" alt="Logo" class="logo" id="displayLogo">
        <h1 class="main-title" id="displayMainTitle">Green Leader<br>Program</h1>
        
        <div class="agenda-list" id="agendaListContainer"></div>

        <div class="event-date" id="displayDate">18.11.2026</div>
    </div>

    <!-- DYNAMIC SLIDES CONTAINER -->
    <div id="slidesContainer"></div>

    <!-- SUBTLE SETTINGS TRIGGER -->
    <button type="button" class="edit-trigger-btn" id="openEditorBtn" title="Edit Presentation">⚙️</button>

    <!-- CUSTOMIZATION EDITOR MODAL -->
    <div class="editor-modal" id="editorModal">
        <div class="editor-box">
            <div class="editor-header">
                <h3>Edit Presentation Details</h3>
                <button type="button" class="close-editor-btn" id="closeEditorBtn">&times;</button>
            </div>

            <div class="editor-body">
                <!-- General Info -->
                <div class="form-section">
                    <div class="form-section-title">1. Main Title, Date &amp; Images (PNG, JPG, GIF)</div>
                    
                    <div class="form-grid">
                        <div class="form-group">
                            <label>Main Title (Use Enter for new line)</label>
                            <textarea class="form-control" id="inputMainTitle" rows="2" placeholder="Enter Event Main Title..."></textarea>
                        </div>
                        <div class="form-group">
                            <label>Event Date</label>
                            <input type="text" class="form-control" id="inputDate" placeholder="e.g. 18.11.2026">
                        </div>
                    </div>

                    <div class="form-grid">
                        <div class="form-group">
                            <label>Background Image (PNG, JPG, GIF)</label>
                            <div class="file-row">
                                <label class="file-label-btn">
                                    Choose File
                                    <input type="file" id="bgFileInput" accept="image/png, image/jpeg, image/gif, image/webp" hidden>
                                </label>
                                <span id="bgFileStatus" style="font-size: 0.8rem; color: #94A3B8;">Default Image</span>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Top Logo (PNG, JPG, GIF)</label>
                            <div class="file-row">
                                <label class="file-label-btn">
                                    Choose Logo
                                    <input type="file" id="logoFileInput" accept="image/png, image/jpeg, image/gif, image/webp" hidden>
                                </label>
                                <button type="button" class="small-clear-btn" id="toggleLogoBtn">Hide Logo</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Agenda Items & Slides -->
                <div class="form-section">
                    <div class="form-section-title">2. Agenda Items &amp; Slides</div>
                    <div id="slidesEditorList" style="display: flex; flex-direction: column; gap: 10px;"></div>
                    <button type="button" class="add-item-btn" id="addSlideItemBtn">+ Add New Agenda Item &amp; Slide</button>
                </div>
            </div>

            <div class="editor-footer">
                <div class="footer-left-actions">
                    <button type="button" class="blank-btn" id="newBlankBtn">New Blank</button>
                    <button type="button" class="reset-btn" id="resetDefaultBtn">Reset Default</button>
                </div>
                <button type="button" class="save-btn" id="saveEditorBtn">Save &amp; Apply</button>
            </div>
        </div>
    </div>

    <script>
        const DEFAULT_BG = "https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=1920&q=80";
        const DEFAULT_LOGO = "https://via.placeholder.com/44";

        const blankConfig = {
            mainTitle: "Event Title",
            date: "DD.MM.YYYY",
            bgImage: DEFAULT_BG,
            logoImage: DEFAULT_LOGO,
            showLogo: true,
            items: [
                {
                    menuTitle: "Agenda Item 1",
                    slideTitle: "Agenda Item 1",
                    slideText: "Enter details here..."
                }
            ]
        };

        const defaultConfig = {
            mainTitle: "Green Leader\nProgram",
            date: "18.11.2026",
            bgImage: DEFAULT_BG,
            logoImage: DEFAULT_LOGO,
            showLogo: true,
            items: [
                {
                    menuTitle: "Religious Observances",
                    slideTitle: "Religious Observances",
                    slideText: "Opening Blessings & Mindfulness,\nNational College of Education on Technology,\nKuliyapitiya."
                },
                {
                    menuTitle: "Lighting the Oil Lamp",
                    slideTitle: "Lighting the Oil Lamp",
                    slideText: "Chief Guest & Distinguished Invitees,\nNational College of Education on Technology,\nKuliyapitiya."
                },
                {
                    menuTitle: "Environmental Song",
                    slideTitle: "Environmental Song",
                    slideText: "College Choir,\nAesthetic Unit,\nNational College of Education on Technology, Kuliyapitiya."
                },
                {
                    menuTitle: "Welcome Speech",
                    slideTitle: "Welcome Speech",
                    slideText: "Nilmini Pushpamali,\nVice President - Administration & Finance,\nNational College of Education on Technology, Kuliyapitiya."
                },
                {
                    menuTitle: "Explaining the Objective",
                    slideTitle: "Explaining the Objective",
                    slideText: "Program Coordinator,\nGreen Leader Program 2026,\nNational College of Education on Technology, Kuliyapitiya."
                },
                {
                    menuTitle: "Lecture - 1",
                    slideTitle: "Lecture - 1",
                    slideText: "Speaker Name Here,\nDesignation / Title,\nInstitution / Organization."
                },
                {
                    menuTitle: "Group Song",
                    slideTitle: "Group Song",
                    slideText: "Student Teachers (2026 Batch),\nNational College of Education on Technology,\nKuliyapitiya."
                },
                {
                    menuTitle: "Lecture - 2",
                    slideTitle: "Lecture - 2",
                    slideText: "Speaker Name Here,\nDesignation / Title,\nInstitution / Organization."
                },
                {
                    menuTitle: "Tea Break",
                    slideTitle: "Tea Break",
                    slideText: "Refreshments for All Participants,\nMain Auditorium Lobby."
                },
                {
                    menuTitle: "Lecture - 3",
                    slideTitle: "Lecture - 3",
                    slideText: "Speaker Name Here,\nDesignation / Title,\nInstitution / Organization."
                },
                {
                    menuTitle: "Vote of Thanks",
                    slideTitle: "Vote of Thanks",
                    slideText: "Secretary of the Organizing Committee,\nNational College of Education on Technology,\nKuliyapitiya."
                },
                {
                    menuTitle: "College Anthem",
                    slideTitle: "College Anthem",
                    slideText: "Closing Ceremony,\nNational College of Education on Technology,\nKuliyapitiya."
                }
            ]
        };

        // IndexedDB helper to support large PNG/JPG/GIF files reliably
        const DB_NAME = "EventPresentationDB";
        const STORE_NAME = "settingsStore";

        function openDB() {
            return new Promise((resolve, reject) => {
                const req = indexedDB.open(DB_NAME, 1);
                req.onupgradeneeded = () => req.result.createObjectStore(STORE_NAME);
                req.onsuccess = () => resolve(req.result);
                req.onerror = () => reject(req.error);
            });
        }

        async function saveConfigToDB(data) {
            try {
                const db = await openDB();
                return new Promise((resolve, reject) => {
                    const tx = db.transaction(STORE_NAME, "readwrite");
                    tx.objectStore(STORE_NAME).put(data, "config");
                    tx.oncomplete = () => resolve();
                    tx.onerror = () => reject(tx.error);
                });
            } catch (err) {
                console.warn("Storage fallback:", err);
            }
        }

        async function loadConfigFromDB() {
            try {
                const db = await openDB();
                return new Promise((resolve) => {
                    const tx = db.transaction(STORE_NAME, "readonly");
                    const req = tx.objectStore(STORE_NAME).get("config");
                    req.onsuccess = () => resolve(req.result || null);
                    req.onerror = () => resolve(null);
                });
            } catch (err) {
                return null;
            }
        }

        let currentConfig = JSON.parse(JSON.stringify(defaultConfig));
        let draftConfig = null;

        const agendaScreen = document.getElementById('agendaScreen');
        const agendaListContainer = document.getElementById('agendaListContainer');
        const slidesContainer = document.getElementById('slidesContainer');
        const displayMainTitle = document.getElementById('displayMainTitle');
        const displayDate = document.getElementById('displayDate');
        const displayLogo = document.getElementById('displayLogo');

        function renderPresentation() {
            document.documentElement.style.backgroundImage = `url('${currentConfig.bgImage}')`;
            document.body.style.backgroundImage = `url('${currentConfig.bgImage}')`;

            displayLogo.src = currentConfig.logoImage;
            if (currentConfig.showLogo) {
                displayLogo.classList.remove('hidden');
            } else {
                displayLogo.classList.add('hidden');
            }

            displayMainTitle.innerHTML = escapeHTML(currentConfig.mainTitle).replace(/\n/g, '<br>');
            displayDate.textContent = currentConfig.date;

            agendaListContainer.innerHTML = '';
            slidesContainer.innerHTML = '';

            currentConfig.items.forEach((item, index) => {
                const slideId = `slide-${index}`;

                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'agenda-btn';
                btn.textContent = item.menuTitle;
                btn.addEventListener('click', () => openSlideById(slideId));
                agendaListContainer.appendChild(btn);

                const section = document.createElement('section');
                section.className = 'slide-screen';
                section.id = slideId;

                const backBtn = document.createElement('button');
                backBtn.type = 'button';
                backBtn.className = 'back-btn';
                backBtn.textContent = 'Back';
                backBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    returnToAgenda();
                });

                const wrapper = document.createElement('div');
                wrapper.className = 'simple-slide-wrapper';

                const h2 = document.createElement('h2');
                h2.className = 'simple-slide-title';
                h2.textContent = item.slideTitle;

                const box = document.createElement('div');
                box.className = 'simple-slide-box';

                const p = document.createElement('p');
                p.className = 'simple-slide-text';
                p.textContent = item.slideText;

                box.appendChild(p);
                wrapper.appendChild(h2);
                wrapper.appendChild(box);
                section.appendChild(backBtn);
                section.appendChild(wrapper);

                section.addEventListener('click', (e) => {
                    if (!e.target.closest('.simple-slide-box')) {
                        returnToAgenda();
                    }
                });

                slidesContainer.appendChild(section);
            });
        }

        function escapeHTML(str) {
            const div = document.createElement('div');
            div.textContent = str;
            return div.innerHTML;
        }

        function openSlideById(slideId) {
            agendaScreen.classList.add('hidden');
            document.querySelectorAll('.slide-screen').forEach(s => s.classList.remove('active'));
            const target = document.getElementById(slideId);
            if (target) target.classList.add('active');
        }

        function returnToAgenda() {
            document.querySelectorAll('.slide-screen').forEach(s => s.classList.remove('active'));
            agendaScreen.classList.remove('hidden');
        }

        document.addEventListener('keydown', (e) => {
            if (editorModal.classList.contains('open')) return;
            const activeSlide = document.querySelector('.slide-screen.active');
            if (!activeSlide) return;

            const allSlides = Array.from(document.querySelectorAll('.slide-screen'));
            const currentIndex = allSlides.indexOf(activeSlide);

            if (e.key === 'Escape') {
                returnToAgenda();
            } else if (e.key === 'ArrowRight' && currentIndex < allSlides.length - 1) {
                openSlideById(allSlides[currentIndex + 1].id);
            } else if (e.key === 'ArrowLeft' && currentIndex > 0) {
                openSlideById(allSlides[currentIndex - 1].id);
            }
        });

        /* ================= EDITOR MODAL LOGIC ================= */
        const editorModal = document.getElementById('editorModal');
        const openEditorBtn = document.getElementById('openEditorBtn');
        const closeEditorBtn = document.getElementById('closeEditorBtn');
        const inputMainTitle = document.getElementById('inputMainTitle');
        const inputDate = document.getElementById('inputDate');
        const bgFileInput = document.getElementById('bgFileInput');
        const bgFileStatus = document.getElementById('bgFileStatus');
        const logoFileInput = document.getElementById('logoFileInput');
        const toggleLogoBtn = document.getElementById('toggleLogoBtn');
        const slidesEditorList = document.getElementById('slidesEditorList');
        const addSlideItemBtn = document.getElementById('addSlideItemBtn');
        const newBlankBtn = document.getElementById('newBlankBtn');
        const saveEditorBtn = document.getElementById('saveEditorBtn');
        const resetDefaultBtn = document.getElementById('resetDefaultBtn');

        function populateEditorFields() {
            inputMainTitle.value = draftConfig.mainTitle;
            inputDate.value = draftConfig.date;
            bgFileStatus.textContent = draftConfig.bgImage.startsWith('data:') ? 'Custom Image Loaded' : 'Default Image';
            toggleLogoBtn.textContent = draftConfig.showLogo ? 'Hide Logo' : 'Show Logo';
            renderEditorItems();
        }

        openEditorBtn.addEventListener('click', () => {
            draftConfig = JSON.parse(JSON.stringify(currentConfig));
            populateEditorFields();
            editorModal.classList.add('open');
        });

        closeEditorBtn.addEventListener('click', () => {
            editorModal.classList.remove('open');
        });

        bgFileInput.addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = (ev) => {
                draftConfig.bgImage = ev.target.result;
                bgFileStatus.textContent = file.name;
            };
            reader.readAsDataURL(file);
        });

        logoFileInput.addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = (ev) => {
                draftConfig.logoImage = ev.target.result;
                draftConfig.showLogo = true;
                toggleLogoBtn.textContent = 'Hide Logo';
            };
            reader.readAsDataURL(file);
        });

        toggleLogoBtn.addEventListener('click', () => {
            draftConfig.showLogo = !draftConfig.showLogo;
            toggleLogoBtn.textContent = draftConfig.showLogo ? 'Hide Logo' : 'Show Logo';
        });

        function renderEditorItems() {
            slidesEditorList.innerHTML = '';
            draftConfig.items.forEach((item, idx) => {
                const card = document.createElement('div');
                card.className = 'slide-edit-card';

                card.innerHTML = `
                    <div class="slide-edit-top">
                        <span class="slide-num-tag">Item #${idx + 1}</span>
                        <div class="slide-card-actions">
                            <button type="button" class="icon-btn up-btn" title="Move Up">↑</button>
                            <button type="button" class="icon-btn down-btn" title="Move Down">↓</button>
                            <button type="button" class="icon-btn del del-btn" title="Delete">✕</button>
                        </div>
                    </div>
                    <div class="form-grid">
                        <div class="form-group">
                            <label>Agenda Menu Title</label>
                            <input type="text" class="form-control menu-title-input" value="${escapeAttr(item.menuTitle)}">
                        </div>
                        <div class="form-group">
                            <label>Slide Heading</label>
                            <input type="text" class="form-control slide-title-input" value="${escapeAttr(item.slideTitle)}">
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Slide Box Content</label>
                        <textarea class="form-control slide-text-input" rows="2">${escapeHTML(item.slideText)}</textarea>
                    </div>
                `;

                const menuInput = card.querySelector('.menu-title-input');
                const slideTitleInput = card.querySelector('.slide-title-input');
                const slideTextInput = card.querySelector('.slide-text-input');

                menuInput.addEventListener('input', (e) => {
                    draftConfig.items[idx].menuTitle = e.target.value;
                });
                slideTitleInput.addEventListener('input', (e) => {
                    draftConfig.items[idx].slideTitle = e.target.value;
                });
                slideTextInput.addEventListener('input', (e) => {
                    draftConfig.items[idx].slideText = e.target.value;
                });

                card.querySelector('.up-btn').addEventListener('click', () => {
                    if (idx > 0) {
                        const temp = draftConfig.items[idx - 1];
                        draftConfig.items[idx - 1] = draftConfig.items[idx];
                        draftConfig.items[idx] = temp;
                        renderEditorItems();
                    }
                });

                card.querySelector('.down-btn').addEventListener('click', () => {
                    if (idx < draftConfig.items.length - 1) {
                        const temp = draftConfig.items[idx + 1];
                        draftConfig.items[idx + 1] = draftConfig.items[idx];
                        draftConfig.items[idx] = temp;
                        renderEditorItems();
                    }
                });

                card.querySelector('.del-btn').addEventListener('click', () => {
                    if (draftConfig.items.length > 1) {
                        draftConfig.items.splice(idx, 1);
                        renderEditorItems();
                    }
                });

                slidesEditorList.appendChild(card);
            });
        }

        function escapeAttr(str) {
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/"/g, '&quot;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;');
        }

        addSlideItemBtn.addEventListener('click', () => {
            const nextNum = draftConfig.items.length + 1;
            draftConfig.items.push({
                menuTitle: `Agenda Item ${nextNum}`,
                slideTitle: `Agenda Item ${nextNum}`,
                slideText: "Enter details here..."
            });
            renderEditorItems();
            const editorBody = document.querySelector('.editor-body');
            editorBody.scrollTop = editorBody.scrollHeight;
        });

        // Start a clean blank presentation ready for new entries
        newBlankBtn.addEventListener('click', () => {
            draftConfig = JSON.parse(JSON.stringify(blankConfig));
            populateEditorFields();
            const editorBody = document.querySelector('.editor-body');
            editorBody.scrollTop = 0;
        });

        saveEditorBtn.addEventListener('click', async () => {
            draftConfig.mainTitle = inputMainTitle.value;
            draftConfig.date = inputDate.value;
            currentConfig = JSON.parse(JSON.stringify(draftConfig));
            await saveConfigToDB(currentConfig);
            renderPresentation();
            returnToAgenda();
            editorModal.classList.remove('open');
        });

        resetDefaultBtn.addEventListener('click', async () => {
            if (confirm("Restore the original default template?")) {
                currentConfig = JSON.parse(JSON.stringify(defaultConfig));
                await saveConfigToDB(currentConfig);
                renderPresentation();
                returnToAgenda();
                editorModal.classList.remove('open');
            }
        });

        (async function init() {
            const saved = await loadConfigFromDB();
            if (saved) {
                currentConfig = saved;
            }
            renderPresentation();
        })();
    </script>

</body>
</html>
